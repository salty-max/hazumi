{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The isolated linker keeps root @types out of each package's resolution
    // scope, so bun's types must be requested explicitly.
    "types": ["bun", "react", "react-dom"],
    "jsx": "react-jsx"
  },
  "include": ["src/**/*", "test/**/*"]
}
