{
  "name": "@hazumi/vite-plugin",
  "version": "0.1.0",
  "description": "Optional build-time auto-import for global-style scenes.",
  "license": "MIT",
  "files": [
    "dist",
    "globals.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "peerDependencies": {
    "vite": ">=5"
  }
}
