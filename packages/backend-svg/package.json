{
  "name": "@hazumi/backend-svg",
  "version": "0.1.0",
  "description": "Vector export backend.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salty-max/hazumi.git",
    "directory": "packages/backend-svg"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@hazumi/color": "workspace:^",
    "@hazumi/core": "workspace:^",
    "@hazumi/graphics": "workspace:*",
    "@hazumi/math": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  }
}
