{
  "name": "hazumi",
  "version": "0.1.0",
  "description": "A typed 2D graphics library built on a retained command buffer.",
  "homepage": "https://hazumi-eta.vercel.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salty-max/hazumi.git",
    "directory": "packages/hazumi"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./draw": {
      "types": "./dist/draw.d.ts",
      "default": "./dist/draw.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "default": "./dist/scene.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "default": "./dist/assets.js"
    },
    "./math": {
      "types": "./dist/math.d.ts",
      "default": "./dist/math.js"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "default": "./dist/color.js"
    },
    "./audio": {
      "types": "./dist/audio.d.ts",
      "default": "./dist/audio.js"
    },
    "./physics": {
      "types": "./dist/physics.d.ts",
      "default": "./dist/physics.js"
    },
    "./debug": {
      "types": "./dist/debug.d.ts",
      "default": "./dist/debug.js"
    },
    "./backends/webgl2": {
      "types": "./dist/backends/webgl2.d.ts",
      "default": "./dist/backends/webgl2.js"
    },
    "./backends/canvas2d": {
      "types": "./dist/backends/canvas2d.d.ts",
      "default": "./dist/backends/canvas2d.js"
    },
    "./backends/svg": {
      "types": "./dist/backends/svg.d.ts",
      "default": "./dist/backends/svg.js"
    },
    "./backends/headless": {
      "types": "./dist/backends/headless.d.ts",
      "default": "./dist/backends/headless.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@hazumi/audio": "workspace:^",
    "@hazumi/backend-canvas2d": "workspace:^",
    "@hazumi/backend-headless": "workspace:^",
    "@hazumi/backend-svg": "workspace:^",
    "@hazumi/backend-webgl2": "workspace:^",
    "@hazumi/color": "workspace:^",
    "@hazumi/core": "workspace:^",
    "@hazumi/graphics": "workspace:^",
    "@hazumi/math": "workspace:^",
    "@hazumi/physics": "workspace:^"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
