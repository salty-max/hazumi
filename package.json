{
  "name": "matter-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@matter/backend-canvas2d": "workspace:*",
    "@matter/backend-headless": "workspace:*",
    "@matter/backend-svg": "workspace:*",
    "@matter/backend-webgl2": "workspace:*",
    "@matter/graphics": "workspace:*",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "matter": "workspace:*",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
