{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["tsconfig.base.json", ".oxlintrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tsdown.config.ts", "package.json", "tsconfig.json"],
      "outputs": ["dist/**"]
    },
    "@hazumi/web#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/examples/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "test/**", "tsconfig.json"],
      "outputs": []
    },
    "hazumi#typecheck": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "tsconfig.json"],
      "outputs": []
    },
    "@hazumi/docs#typecheck": {
      // Its own build, not just its dependencies': the coverage test imports
      // the generated `dist/catalog.json`, so without this edge turbo is free
      // to run tsc alongside the script that writes it. It passed here for
      // months only because the file was already on disk from a previous run.
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**"],
      "outputs": []
    },
    "test:browser": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "playwright.config.ts"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
