{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "no-console": "warn",
    "eqeqeq": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/.turbo/**"],
  "overrides": [
    {
      "files": ["bench/**", "examples/**", "apps/docs/src/build.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
